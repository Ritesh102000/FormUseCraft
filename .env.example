# Copy to .env for local setup. Never commit populated environment files.
# See DEPLOY.md for the hosted Vercel setup; do not upload this local file.

# Required: your own PostgreSQL database. Use a pooled TLS URL on Vercel.
# DATABASE_URL is also accepted when FORMCRAFT_DATABASE_URL is not set.
FORMCRAFT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
FORMCRAFT_DB_POOL_SIZE=5

# admin = local builder; hosted = online owner dashboard; public = forms only.
FORMCRAFT_ROLE=admin
# Keep 0 locally. Remote admin requires your own authenticated proxy or VPN.
FORMCRAFT_ADMIN_ALLOW_REMOTE=0
FORMCRAFT_ADMIN_USERNAME=admin
# Generate these with: uv run python scripts/set_password.py
FORMCRAFT_ADMIN_PASSWORD_HASH=
FORMCRAFT_SECRET_KEY=

# Your organization name. The separate catapultaiwork provider credit stays.
FORMCRAFT_BRAND_NAME=Formcraft
FORMCRAFT_OWNER_NAME=
FORMCRAFT_OWNER_ROLE=
# Public URL used for share links. Set to your Vercel/custom domain when deployed.
FORMCRAFT_BASE_URL=http://127.0.0.1:8480
# Local HTTP admin needs 0. Set 1 on HTTPS deployments.
FORMCRAFT_SECURE_COOKIES=0

# Google is optional. Submissions are saved to PostgreSQL regardless.
FORMCRAFT_GOOGLE_ENABLED=0
FORMCRAFT_GOOGLE_CLIENT_SECRET_FILE=data/google_client_secret.json
FORMCRAFT_GOOGLE_TOKEN_FILE=data/google_token.json
# For Vercel: protected JSON from scripts/google_setup.py, never a public variable.
FORMCRAFT_GOOGLE_TOKEN_JSON=
FORMCRAFT_GOOGLE_DEFAULT_PROFILE=default

# Optional native Calendar/Meet booking: scripts/google_setup.py --profile booking
# The booking profile includes Sheets plus Calendar scopes. It can use the same
# Google account as default. Existing forms keep their stored profile.
FORMCRAFT_GOOGLE_TOKEN_FILE_BOOKING=data/google_token_booking.json
FORMCRAFT_GOOGLE_TOKEN_JSON_BOOKING=
FORMCRAFT_GOOGLE_CALENDAR_ID=primary
# Required for native booking on a public deployment. Generate independently:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
FORMCRAFT_BOOKING_HMAC_SECRET=

# Hosted Vercel mode defaults are set by index.py; Google connects in the browser.
# Use an owner password of at least 12 characters OR the Argon2 hash above.
FORMCRAFT_ADMIN_PASSWORD=
# Hosted mode requires SECRET_KEY >=32 random characters and secure cookies.
# Configure a Web application OAuth client, not the local Desktop client.
FORMCRAFT_GOOGLE_CLIENT_ID=
FORMCRAFT_GOOGLE_CLIENT_SECRET=
# Hosted Google grants are encrypted in PostgreSQL; local token variables above
# are only used by the optional local-admin/public split modes.

# Optional owner AI builder. Use your own OpenAI project key, never commit it.
OPENAI_API_KEY=
# Optional override of OPENAI_API_KEY; leave empty unless needed.
FORMCRAFT_OPENAI_API_KEY=
FORMCRAFT_AI_MODEL=gpt-4.1-mini
FORMCRAFT_AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# An environment key makes voice available automatically.
# Public voice still requires per-form opt-in and SECRET_KEY >=32 characters.
# Recordings are sent to OpenAI only after the visitor starts voice assistance.
FORMCRAFT_AI_VOICE_DAILY_TURNS=200

# Advanced local browser Google mode; scripts/dev.py enables this automatically.
# Only loopback admin access is allowed. Hosted mode always uses browser Google.
# FORMCRAFT_LOCAL_BROWSER_GOOGLE=1
